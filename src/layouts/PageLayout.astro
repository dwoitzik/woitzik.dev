---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@consts";
import Analytics from "@vercel/analytics/astro";

type Props = {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: string;
  tags?: string[];
  lang?: "en" | "de";
  alternates?: { href: string; hreflang: string }[];
};

const {
  title,
  description,
  image,
  type,
  publishedTime,
  tags,
  lang = "en",
  alternates = [],
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <Head
      title={`${title} | ${SITE.NAME}`}
      description={description}
      image={image}
      type={type}
      publishedTime={publishedTime}
      tags={tags}
      lang={lang}
      alternates={alternates}
    />
    <script
      src="https://analytics.woitzik.dev/api/script.js"
      data-site-id="a52de9f046eb"
      defer></script>
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-sky-600 focus:text-white focus:rounded-md focus:text-sm focus:font-medium"
    >
      Skip to content
    </a>
    <Header />
    <main id="main-content" data-pagefind-body>
      <slot />
    </main>
    <Footer />
    <Analytics />
    <button
      id="back-to-top"
      aria-label="Back to top"
      class="fixed bottom-6 right-6 z-40 p-2.5 rounded-full bg-neutral-900 dark:bg-white text-white dark:text-black shadow-lg transition-opacity duration-300"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M18 15l-6-6-6 6"></path>
      </svg>
    </button>
    <script>
      // This used to be is:inline, which Astro re-executes after every
      // ClientRouter navigation. Each swap stacked another document-level
      // click listener, so a single affiliate click got recorded once per
      // navigation the reader had already made - affiliate_click is the
      // metric that decides which products get promoted, so overcounting it
      // distorts exactly the number we steer by. A bundled module script runs
      // once per session; the flag keeps registration idempotent regardless.
      type AffiliateTrackingWindow = Window & {
        __affiliateClickTracking?: boolean;
        va?: (
          name: string,
          payload: { name: string; data: Record<string, string> },
        ) => void;
        rybbit?: {
          event?: (name: string, props: Record<string, string>) => void;
        };
      };

      const win = window as AffiliateTrackingWindow;

      if (!win.__affiliateClickTracking) {
        win.__affiliateClickTracking = true;
        document.addEventListener("click", (event) => {
          const target = event.target as Element | null;
          const link = target?.closest?.("a");
          if (!link) return;
          const href = link.getAttribute("href") || "";
          const isAffiliate =
            href.indexOf("amzn.to") !== -1 ||
            href.indexOf("amazon.") !== -1 ||
            href.indexOf("/go/") !== -1;
          if (!isAffiliate) return;
          const slug = href.split("/").pop() || "unknown";
          const page = location.pathname;
          win.va?.("event", {
            name: "affiliate_click",
            data: { url: href, slug, page },
          });
          win.rybbit?.event?.("affiliate_click", { url: href, slug, page });
        });
      }
    </script>
    <script is:inline>
      function handleBackToTop() {
        document.documentElement.classList.toggle(
          "scrolled",
          window.scrollY > 400,
        );
      }
      window.addEventListener("scroll", handleBackToTop, { passive: true });
      document.addEventListener("astro:after-swap", function () {
        window.addEventListener("scroll", handleBackToTop, { passive: true });
      });
    </script>
  </body>
</html>
