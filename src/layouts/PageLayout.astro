---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@consts";
import Analytics from "@vercel/analytics/astro";

type Props = {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: string;
  tags?: string[];
};

const { title, description, image, type, publishedTime, tags } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title={`${title} | ${SITE.NAME}`}
      description={description}
      image={image}
      type={type}
      publishedTime={publishedTime}
      tags={tags}
    />
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-sky-600 focus:text-white focus:rounded-md focus:text-sm focus:font-medium"
    >
      Skip to content
    </a>
    <Header />
    <main id="main-content" data-pagefind-body>
      <slot />
    </main>
    <Footer />
    <Analytics />
    <button
      id="back-to-top"
      aria-label="Back to top"
      class="fixed bottom-6 right-6 z-40 p-2.5 rounded-full bg-neutral-900 dark:bg-white text-white dark:text-black shadow-lg transition-opacity duration-300"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M18 15l-6-6-6 6"></path>
      </svg>
    </button>
    <script is:inline>
      document.addEventListener("click", function (e) {
        var link = e.target.closest("a");
        if (!link) return;
        var href = link.getAttribute("href") || "";
        if (
          href.indexOf("amzn.to") !== -1 ||
          href.indexOf("amazon.") !== -1 ||
          href.indexOf("/go/") !== -1
        ) {
          var slug = href.split("/").pop() || "unknown";
          if (typeof window.va === "function") {
            window.va("event", {
              name: "affiliate_click",
              data: { url: href, slug: slug, page: location.pathname },
            });
          }
          if (typeof window.gtag === "function") {
            window.gtag("event", "affiliate_click", {
              url: href,
              slug: slug,
              page_path: location.pathname,
            });
          }
        }
      });
    </script>
    <script is:inline>
      function handleBackToTop() {
        document.documentElement.classList.toggle(
          "scrolled",
          window.scrollY > 400,
        );
      }
      window.addEventListener("scroll", handleBackToTop, { passive: true });
      document.addEventListener("astro:after-swap", function () {
        window.addEventListener("scroll", handleBackToTop, { passive: true });
      });
    </script>
  </body>
</html>
