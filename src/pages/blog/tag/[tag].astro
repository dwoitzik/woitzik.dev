---
import { tagSlug } from "@lib/utils";
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import PageHeader from "@components/PageHeader.astro";
import PostList from "@components/PostList.astro";
import tagDescriptions from "@data/tag-descriptions.json";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter((p) => !p.data.draft);
  const tags = [...new Set(posts.flatMap((p) => p.data.tags ?? []))];
  return tags.map((tag) => ({
    params: { tag: tagSlug(tag) },
    props: {
      tag,
      posts: posts
        .filter((p) => p.data.tags?.includes(tag) && !p.data.draft)
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;
const description =
  (tagDescriptions as Record<string, string>)[tag] ??
  `Articles tagged ${tag} on woitzik.dev: hands-on infrastructure guides, homelab notes, and troubleshooting write-ups.`;
---

<PageLayout title={`${tag} articles`} description={description}>
  <Container>
    <PageHeader
      eyebrow="Topic"
      title={tag}
      description={description}
      meta={`${posts.length} article${posts.length !== 1 ? "s" : ""}`}
    >
      <a
        href="/blog/"
        class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-teal-700 hover:text-teal-800 dark:text-teal-400 dark:hover:text-teal-300"
      >
        &larr; All topics
      </a>
    </PageHeader>
    <div class="animate">
      <PostList posts={posts} />
    </div>
  </Container>
</PageLayout>
