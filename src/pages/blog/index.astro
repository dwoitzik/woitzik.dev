---
import { tagSlug } from "@lib/utils";
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import PageHeader from "@components/PageHeader.astro";
import PostList from "@components/PostList.astro";
import { BLOG } from "@consts";

const data = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// German posts have no internal links from the English side, so they were
// effectively invisible in the year-grouped listing. Surface them in their own
// section with links to the English original where one exists.
const german = data.filter((post) => post.data.lang === "de");

type Acc = {
  [year: string]: CollectionEntry<"blog">[];
};

const posts = data.reduce((acc: Acc, post) => {
  const year = post.data.date.getFullYear().toString();
  if (!acc[year]) {
    acc[year] = [];
  }
  acc[year].push(post);
  return acc;
}, {});

const years = Object.keys(posts).sort((a, b) => parseInt(b) - parseInt(a));
const allTags = [...new Set(data.flatMap((p) => p.data.tags ?? []))].sort();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": "https://woitzik.dev/blog/#blog",
  name: BLOG.TITLE,
  description: BLOG.DESCRIPTION,
  url: "https://woitzik.dev/blog/",
  author: { "@id": "https://woitzik.dev/#person" },
  publisher: { "@id": "https://woitzik.dev/#person" },
  isPartOf: { "@id": "https://woitzik.dev/#website" },
  inLanguage: ["en", "de"],
};
---

<PageLayout title={BLOG.TITLE} description={BLOG.DESCRIPTION}>
  <Container>
    <PageHeader
      eyebrow="Blog"
      title="Notes from production and the homelab"
      description="Incidents, fixes and design decisions from Azure work and a single-host Proxmox homelab: what broke, why, and what held."
      meta={`${data.length} articles${german.length > 0 ? ` · ${german.length} in German` : ""}`}
    />

    <nav class="animate mb-14" aria-label="Topics">
      <h2
        class="mb-3 text-xs font-semibold uppercase tracking-wider text-zinc-950 dark:text-white"
      >
        Browse by topic
      </h2>
      <ul class="flex flex-wrap gap-2 sm:gap-1.5">
        {
          allTags.map((tag) => (
            <li>
              <a
                href={`/blog/tag/${tagSlug(tag)}/`}
                class="flex min-h-9 items-center rounded-md border border-zinc-900/[0.08] dark:border-white/[0.08] px-3 py-1.5 text-xs sm:min-h-0 sm:px-2.5 sm:py-1 text-zinc-600 dark:text-zinc-400 hover:border-teal-500/50 hover:text-teal-700 dark:hover:text-teal-400 transition-colors"
              >
                {tag}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="space-y-14">
      {
        years.map((year) => (
          <section class="animate">
            <h2 class="border-b border-zinc-900/[0.07] dark:border-white/[0.07] pb-3 font-mono text-sm font-semibold text-zinc-950 dark:text-white">
              {year}
            </h2>
            <PostList
              posts={posts[year].filter((post) => post.data.lang !== "de")}
            />
          </section>
        ))
      }

      {
        german.length > 0 && (
          <section class="animate" lang="de">
            <h2 class="border-b border-zinc-900/[0.07] dark:border-white/[0.07] pb-3 text-sm font-semibold text-zinc-950 dark:text-white">
              Auf Deutsch
            </h2>
            <PostList posts={german} showTranslationLink />
          </section>
        )
      }
    </div>
  </Container>
</PageLayout>

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(jsonLd)}
/>
