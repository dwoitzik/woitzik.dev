---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { postText, readingTime, tagSlug } from "@lib/utils";
import TableOfContents from "@components/TableOfContents.astro";
import EmailCapture from "@components/EmailCapture.astro";
import ShareButtons from "@components/ShareButtons.astro";
import AuthorBio from "@components/AuthorBio.astro";
import FeedbackWidget from "@components/FeedbackWidget.astro";
import SupportCTA from "@components/SupportCTA.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog"))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  // Translation clusters. A German post names its English original via
  // translationOf; the English post is matched back by whichever German posts
  // point at it. Built in both directions so each side of a cluster can emit the
  // full set of alternates without a second lookup.
  const germanByEnglish = new Map<string, CollectionEntry<"blog">[]>();
  for (const post of posts) {
    const source = post.data.translationOf;
    if (!source) continue;
    const existing = germanByEnglish.get(source);
    if (existing) existing.push(post);
    else germanByEnglish.set(source, [post]);
  }

  return posts.map((post) => {
    const postTags = post.data.tags?.map((t) => t.toLowerCase()) ?? [];
    // Same-language related posts only. Tag similarity alone matched German and
    // English articles on the same technology, so a German reader got English
    // suggestions that hreflang would then contradict.
    //
    // Ranked by how many tags they actually share, then by date. Taking the
    // first three matches instead meant an article got whichever related posts
    // happened to sort first in the collection, which for most posts meant a
    // generic "Kubernetes" neighbour rather than the piece a reader who just
    // finished this one most likely wants next.
    const related = posts
      .filter((p) => p.slug !== post.slug && p.data.lang === post.data.lang)
      .map((p) => ({
        post: p,
        shared: (p.data.tags ?? []).filter((t) =>
          postTags.includes(t.toLowerCase()),
        ).length,
      }))
      .filter((entry) => entry.shared > 0)
      .sort(
        (a, b) =>
          b.shared - a.shared ||
          b.post.data.date.valueOf() - a.post.data.date.valueOf(),
      )
      .slice(0, 3)
      .map((entry) => entry.post);

    const alternates: { href: string; hreflang: string }[] = [];

    if (post.data.lang === "de" && post.data.translationOf) {
      alternates.push({
        href: `/blog/${post.data.translationOf}/`,
        hreflang: "en",
      });
    } else {
      const german = germanByEnglish.get(post.slug) ?? [];
      for (const g of german) {
        alternates.push({ href: `/blog/${g.slug}/`, hreflang: "de" });
      }
    }

    // prev/next stay inside the same language so the footer navigation doesn't
    // bounce a German reader into an English article.
    const sameLang = posts.filter((p) => p.data.lang === post.data.lang);
    const langIndex = sameLang.findIndex((p) => p.slug === post.slug);
    const prev = sameLang[langIndex + 1] ?? null;
    const next = sameLang[langIndex - 1] ?? null;

    return {
      params: { slug: post.slug },
      props: {
        post,
        prev,
        next,
        related,
        alternates,
      },
    };
  });
}

interface Props {
  post: CollectionEntry<"blog">;
  prev: CollectionEntry<"blog"> | null;
  next: CollectionEntry<"blog"> | null;
  related: CollectionEntry<"blog">[];
  alternates: { href: string; hreflang: string }[];
}

const { post, prev, next, related, alternates } = Astro.props;
const { Content, headings } = await post.render();
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const postUrl = `https://woitzik.dev/blog/${post.slug}/`;
const lang = post.data.lang;
const text = postText(lang);

// schema.org translation links run in both directions with different
// properties: the English original lists its German versions under
// workTranslation, and a German page names its English source under
// translationOfWork. Using translationOfWork on the English side (as this
// did before) claimed the original was a translation of its own translation.
const germanVersions =
  post.data.lang !== "de" ? alternates.filter((a) => a.hreflang === "de") : [];
const englishSource =
  post.data.lang === "de"
    ? alternates.find((a) => a.hreflang === "en")
    : undefined;

const ogImage = `https://woitzik.dev/og/${post.slug}.png`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "@id": `${postUrl}#article`,
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated ?? post.data.date).toISOString(),
  author: {
    "@type": "Person",
    "@id": "https://woitzik.dev/#person",
    name: "David Woitzik",
    url: "https://woitzik.dev/",
  },
  publisher: { "@id": "https://woitzik.dev/#person" },
  // The generated share card is the only image every article has. Google's
  // Article guidance asks for at least one image and reads the size from it.
  image: {
    "@type": "ImageObject",
    url: ogImage,
    width: 1200,
    height: 630,
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": postUrl },
  isPartOf: { "@id": "https://woitzik.dev/#website" },
  url: postUrl,
  inLanguage: post.data.lang,
  ...(post.data.tags?.length ? { keywords: post.data.tags.join(", ") } : {}),
  ...(germanVersions.length > 0 && {
    workTranslation: germanVersions.map((g) => ({
      "@type": "TechArticle",
      "@id": `https://woitzik.dev${g.href}#article`,
      url: `https://woitzik.dev${g.href}`,
      inLanguage: "de",
    })),
  }),
  ...(englishSource && {
    translationOfWork: {
      "@type": "TechArticle",
      "@id": `https://woitzik.dev${englishSource.href}#article`,
      url: `https://woitzik.dev${englishSource.href}`,
      inLanguage: "en",
    },
  }),
};

// Mirrors the breadcrumb nav that is already rendered above. Emitting this as
// a second JSON-LD block keeps the TechArticle document byte-for-byte intact
// instead of restructuring it into a @graph, which would risk changing how the
// article node is read. The final ListItem intentionally carries no `item`: it
// is the current page, and pointing it at itself is what produces the
// "Breadcrumb is not a valid breadcrumb" error.
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://woitzik.dev/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Blog",
      item: "https://woitzik.dev/blog/",
    },
    ...(post.data.tags?.length
      ? [
          {
            "@type": "ListItem",
            position: 3,
            name: post.data.tags[0],
            item: `https://woitzik.dev/blog/tag/${tagSlug(post.data.tags[0])}/`,
          },
        ]
      : []),
    {
      "@type": "ListItem",
      position: post.data.tags?.length ? 4 : 3,
      name: post.data.title,
    },
  ],
};
---

<PageLayout
  title={post.data.title}
  description={post.data.description}
  image={`/og/${post.slug}.png`}
  type="article"
  publishedTime={post.data.date.toISOString()}
  modifiedTime={(post.data.updated ?? post.data.date).toISOString()}
  tags={post.data.tags}
  lang={post.data.lang}
  alternates={alternates}
>
  <!-- Reading progress bar -->
  <div
    id="reading-progress"
    class="fixed top-0 left-0 h-[2px] bg-sky-500 z-[60] transition-[width] duration-75 ease-out pointer-events-none"
    style="width: 0%"
  >
  </div>

  <Container>
    <header class="max-w-3xl">
      <!-- Breadcrumbs -->
      <nav class="animate text-xs text-zinc-500 mb-8" aria-label="Breadcrumb">
        <ol class="flex min-w-0 items-center gap-1.5 whitespace-nowrap">
          <li class="shrink-0">
            <a
              href="/"
              class="hover:text-zinc-950 dark:hover:text-white transition-colors"
              >Home</a
            >
          </li>
          <li aria-hidden="true" class="shrink-0 opacity-50">/</li>
          <li class="shrink-0">
            <a
              href="/blog/"
              class="hover:text-zinc-950 dark:hover:text-white transition-colors"
              >Blog</a
            >
          </li>
          {
            post.data.tags && post.data.tags.length > 0 && (
              <>
                <li aria-hidden="true" class="shrink-0 opacity-50">
                  /
                </li>
                <li class="shrink-0">
                  <a
                    href={`/blog/tag/${tagSlug(post.data.tags[0])}/`}
                    class="hover:text-zinc-950 dark:hover:text-white transition-colors"
                  >
                    {post.data.tags[0]}
                  </a>
                </li>
              </>
            )
          }
          <li aria-hidden="true" class="shrink-0 opacity-50">/</li>
          <li
            class="min-w-0 truncate text-zinc-700 dark:text-zinc-300"
            aria-current="page"
          >
            {post.data.title}
          </li>
        </ol>
      </nav>

      <div
        class="animate flex items-center gap-2 font-mono text-xs text-zinc-500 flex-wrap"
      >
        <FormattedDate date={post.data.date} lang={lang} />
        <span aria-hidden="true" class="opacity-50">/</span>
        <span>{readingTime(post.body, lang)}</span>
        {
          post.data.updated && (
            <>
              <span aria-hidden="true" class="opacity-50">
                /
              </span>
              <span>
                {text.updated}{" "}
                <FormattedDate date={post.data.updated} lang={lang} />
              </span>
            </>
          )
        }
      </div>
      <h1
        class="animate mt-3 text-3xl font-bold leading-[1.15] tracking-tight text-zinc-950 dark:text-white sm:text-[2.6rem]"
      >
        {post.data.title}
      </h1>
      {
        /*
        Answer-first summary.

        The frontmatter description was already machine-readable, but only in
        <meta name="description"> and the TechArticle JSON-LD. It never reached the
        rendered text, so nothing on the page stated the article's conclusion in
        its own words. Answer engines quote from body text, not from meta tags, so
        this restates the conclusion directly under the H1 as a self-contained
        passage. The wording is reused verbatim from frontmatter on purpose: a
        paraphrase here would drift from the description that already ranks and
        that structured data asserts.
      */
      }
      {
        post.data.description && (
          <p class="animate mt-5 text-lg leading-relaxed text-zinc-700 dark:text-zinc-300">
            {post.data.description}
          </p>
        )
      }
      {
        post.data.tags && post.data.tags.length > 0 && (
          <div class="animate mt-5 flex flex-wrap gap-1.5">
            {post.data.tags.map((tag) => (
              <a
                href={`/blog/tag/${tagSlug(tag)}/`}
                class="rounded-md border border-zinc-900/10 dark:border-white/10 px-2 py-0.5 text-xs text-zinc-600 dark:text-zinc-400 hover:border-teal-500/50 hover:text-teal-700 dark:hover:text-teal-400 transition-colors"
              >
                {tag}
              </a>
            ))}
          </div>
        )
      }
      <hr
        class="animate mt-8 mb-10 border-zinc-900/[0.07] dark:border-white/[0.07]"
      />
    </header>

    <!-- Mobile TOC (hidden on large screens) -->
    {
      tocHeadings.length > 1 && (
        <div class="animate lg:hidden">
          <TableOfContents headings={headings} lang={lang} />
        </div>
      )
    }

    <!-- Two-column layout: article + sticky sidebar TOC on desktop -->
    <div
      class={`${tocHeadings.length > 1 ? "lg:grid lg:grid-cols-[minmax(0,1fr)_220px] lg:gap-12 lg:items-start" : "max-w-[46rem]"}`}
    >
      <div>
        <article class="animate">
          <Content />
        </article>

        <!-- Feedback + share -->
        <div
          class="animate mt-14 flex flex-wrap items-center justify-between gap-4 rounded-xl border border-zinc-900/[0.08] dark:border-white/[0.08] bg-white/60 dark:bg-white/[0.02] px-4 py-3"
        >
          <FeedbackWidget slug={post.slug} lang={lang} />
          <ShareButtons title={post.data.title} url={postUrl} lang={lang} />
        </div>

        <div class="animate mt-6">
          <AuthorBio lang={lang} />
        </div>

        <!-- Related Posts -->
        {
          related.length > 0 && (
            <section class="animate mt-14">
              <h2 class="mb-4 text-sm font-semibold uppercase tracking-wider text-zinc-950 dark:text-white">
                {text.keepReading}
              </h2>
              <div class="grid gap-3 sm:grid-cols-3">
                {related.map((p) => (
                  <a
                    href={`/blog/${p.slug}/`}
                    class="group flex flex-col rounded-xl border border-zinc-900/[0.08] dark:border-white/[0.08] bg-white dark:bg-white/[0.02] p-4 transition-all hover:-translate-y-0.5 hover:border-teal-500/40"
                  >
                    <h3 class="text-sm font-semibold leading-snug text-zinc-950 transition-colors group-hover:text-teal-700 dark:text-white dark:group-hover:text-teal-400">
                      {p.data.title}
                    </h3>
                    <p class="mt-2 line-clamp-3 text-xs leading-relaxed">
                      {p.data.description}
                    </p>
                  </a>
                ))}
              </div>
            </section>
          )
        }

        <div class="animate mt-14">
          <EmailCapture
            title={text.newsletterTitle}
            description={text.newsletterDescription}
            buttonText={text.newsletterButton}
            successMessage={text.newsletterSuccess}
            lang={lang}
          />
        </div>

        <div class="animate">
          <SupportCTA lang={lang} />
        </div>

        {
          (prev || next) && (
            <nav
              class="animate mt-6 grid gap-3 sm:grid-cols-2"
              aria-label={text.moreArticles}
            >
              {prev ? (
                <a
                  href={`/blog/${prev.slug}/`}
                  class="group flex flex-col gap-1 rounded-xl border border-zinc-900/[0.08] dark:border-white/[0.08] p-4 text-sm transition-colors hover:border-teal-500/40"
                >
                  <span class="text-xs uppercase tracking-wider text-zinc-500">
                    {text.previous}
                  </span>
                  <span class="font-medium leading-snug text-zinc-950 transition-colors group-hover:text-teal-700 dark:text-white dark:group-hover:text-teal-400">
                    &larr; {prev.data.title}
                  </span>
                </a>
              ) : null}
              {next && (
                <a
                  href={`/blog/${next.slug}/`}
                  class="group flex flex-col gap-1 rounded-xl border border-zinc-900/[0.08] dark:border-white/[0.08] p-4 text-sm text-right transition-colors hover:border-teal-500/40 sm:col-start-2"
                >
                  <span class="text-xs uppercase tracking-wider text-zinc-500">
                    {text.next}
                  </span>
                  <span class="font-medium leading-snug text-zinc-950 transition-colors group-hover:text-teal-700 dark:text-white dark:group-hover:text-teal-400">
                    {next.data.title} &rarr;
                  </span>
                </a>
              )}
            </nav>
          )
        }
      </div>

      <!-- Desktop sticky TOC -->
      {
        tocHeadings.length > 1 && (
          <aside class="hidden lg:block sticky top-24 animate">
            <TableOfContents headings={headings} sidebar lang={lang} />
          </aside>
        )
      }
    </div>
  </Container>
</PageLayout>

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(jsonLd)}
/>

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(breadcrumbLd)}
/>

<script is:inline>
  function updateProgress() {
    var bar = document.getElementById("reading-progress");
    if (!bar) return;
    var scrolled = window.scrollY;
    var total = document.documentElement.scrollHeight - window.innerHeight;
    bar.style.width = total > 0 ? (scrolled / total) * 100 + "%" : "0%";
  }
  window.addEventListener("scroll", updateProgress, { passive: true });
</script>
