---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import PageHeader from "@components/PageHeader.astro";

// Kept as data rather than markup so the hub, the llms.txt Tools section and
// each tool's own "Related" list all describe the same set. A tool that exists
// but is not listed here is invisible to both crawlers and readers, which is
// the failure mode this file exists to prevent.
const tools = [
  {
    href: "/tools/raid-calculator/",
    icon: "<rect x='3' y='4' width='18' height='6' rx='1.5'/><rect x='3' y='14' width='18' height='6' rx='1.5'/><path d='M7 7h.01M7 17h.01'/>",
    name: "RAID Capacity Calculator",
    description:
      "Usable capacity, space lost to parity and how many drives can fail, for RAID 0, 1, 5, 6, 10, SHR-1 and SHR-2. Handles mixed drive sizes.",
    context: "NAS and storage",
  },
  {
    href: "/tools/subnet-calculator/",
    icon: "<rect x='9' y='2' width='6' height='6' rx='1'/><rect x='2' y='16' width='6' height='6' rx='1'/><rect x='16' y='16' width='6' height='6' rx='1'/><path d='M12 8v4M5 16v-2h14v2'/>",
    name: "IPv4 and IPv6 Subnet Calculator",
    description:
      "Network address, broadcast or last address, netmask and usable host count for any IPv4 or IPv6 CIDR, including how an IPv4 network splits into /24s, /26s and /28s.",
    context: "Networking",
  },
  {
    href: "/tools/transfer-time-calculator/",
    icon: "<circle cx='12' cy='13' r='8'/><path d='M12 9v4l2.5 2.5M10 2h4'/>",
    name: "Network Transfer Time Calculator",
    description:
      "How long a copy takes over 100 Mbit to 25 Gbit ethernet, at line rate or at the share of throughput you actually expect to see.",
    context: "NAS and networking",
  },
  {
    href: "/tools/vlan-planner/",
    icon: "<path d='M4 6h16M4 12h16M4 18h16'/><path d='M8 4v4M14 10v4M10 16v4'/>",
    name: "VLAN ID Planner",
    description:
      "Validate VLAN IDs against the 802.1Q range, catch duplicates, and find the free blocks left for the next site or segment.",
    context: "Networking",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Free homelab and infrastructure tools",
  url: "https://woitzik.dev/tools/",
  description:
    "Browser-based calculators for RAID capacity, IPv4 and IPv6 subnetting, network transfer times and 802.1Q VLAN planning.",
  isPartOf: { "@id": "https://woitzik.dev/#website" },
  author: { "@id": "https://woitzik.dev/#person" },
};
---

<PageLayout
  title="Tools"
  description="Free browser-based calculators for RAID capacity, IPv4 and IPv6 subnetting, network transfer times and 802.1Q VLAN planning. No sign-up, runs entirely in the page."
>
  <Container>
    <PageHeader
      eyebrow="Tools"
      title="Calculators for infrastructure planning"
      description="The calculators I use while planning homelab and infrastructure work. Each one runs entirely in your browser: nothing is uploaded, there is no sign-up, and every figure is plain arithmetic on the numbers you enter."
    />
    <div class="animate grid gap-4 sm:grid-cols-2">
      {
        tools.map((tool) => (
          <a
            href={tool.href}
            class="group flex gap-4 rounded-xl border border-zinc-900/[0.08] dark:border-white/[0.08] bg-white dark:bg-white/[0.02] p-5 sm:p-6 transition-all hover:-translate-y-0.5 hover:border-teal-500/40"
          >
            <div class="grid size-11 shrink-0 place-items-center rounded-lg bg-teal-500/10 text-teal-700 dark:text-teal-400">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={tool.icon}
              />
            </div>
            <div class="min-w-0">
              <p class="font-mono text-xs text-zinc-500">{tool.context}</p>
              <h2 class="mt-1 font-semibold text-zinc-950 transition-colors group-hover:text-teal-700 dark:text-white dark:group-hover:text-teal-400">
                {tool.name}
              </h2>
              <p class="mt-1.5 text-sm leading-relaxed">{tool.description}</p>
              <span class="mt-3 inline-block text-sm font-medium text-zinc-950 dark:text-white">
                Open &rarr;
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </Container>
</PageLayout>

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(jsonLd)}
/>
