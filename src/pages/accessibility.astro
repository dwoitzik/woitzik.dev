---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";

const accessibilityFeatures = [
  {
    title: "Semantic HTML",
    description:
      "All pages use proper HTML5 semantic elements: header, nav, main, article, footer, aside.",
  },
  {
    title: "Keyboard Navigation",
    description:
      "All interactive elements (links, buttons, form inputs) are fully accessible via keyboard. Visible focus indicators appear on every focusable element.",
  },
  {
    title: "Skip to Content",
    description:
      "A 'Skip to content' link appears as the first focusable element on every page, allowing keyboard users to bypass navigation.",
  },
  {
    title: "Color Contrast",
    description:
      "Text colors meet WCAG 2.2 AA contrast ratios (4.5:1 for normal text, 3:1 for large text) in both light and dark modes.",
  },
  {
    title: "Dark Mode",
    description:
      "A three-way theme toggle (light/dark/system) respects your operating system preference and persists your choice.",
  },
  {
    title: "Responsive Design",
    description:
      "All pages are fully responsive and readable on screens from 320px to 2560px+ without horizontal scrolling.",
  },
  {
    title: "Alt Text",
    description:
      "All meaningful images include descriptive alt text. Decorative images use empty alt attributes.",
  },
  {
    title: "Reduced Motion",
    description:
      "If your system is set to reduce motion (prefers-reduced-motion), the fade-in animations are turned off.",
  },
  {
    title: "Form Labels",
    description:
      "All form inputs have a label or an aria-label, so screen readers announce what each field is for.",
  },
  {
    title: "ARIA Attributes",
    description:
      "Interactive components use appropriate ARIA roles, labels, and states (e.g., aria-label on icon buttons, role=tablist on tab components).",
  },
];
---

<PageLayout
  title="Accessibility"
  description="Accessibility features and commitments for woitzik.dev"
>
  <Container>
    <div class="max-w-2xl space-y-10">
      <div class="animate space-y-1">
        <h1 class="page-title">Accessibility Statement</h1>
        <p
          class="text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed"
        >
          I want woitzik.dev to work for everyone, including people using a
          keyboard, a screen reader, or high zoom. This page lists what the site
          does for that and how to report a problem.
        </p>
      </div>

      <h2 class="font-semibold text-lg text-black dark:text-white">
        Accessibility Features
      </h2>

      <div class="space-y-3">
        {
          accessibilityFeatures.map((feature) => (
            <div class="p-4 rounded-lg border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/50">
              <h3 class="font-semibold text-sm text-black dark:text-white mb-1">
                {feature.title}
              </h3>
              <p class="text-sm text-neutral-500 dark:text-neutral-400 m-0 leading-relaxed">
                {feature.description}
              </p>
            </div>
          ))
        }
      </div>

      <h2 class="font-semibold text-lg text-black dark:text-white">
        Standards
      </h2>
      <p class="text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
        This site strives to conform to <strong>WCAG 2.2 Level AA</strong> standards.
        I regularly test with screen readers (VoiceOver, NVDA) and keyboard-only navigation.
      </p>

      <h2 class="font-semibold text-lg text-black dark:text-white">Feedback</h2>
      <p class="text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
        If you encounter any accessibility barriers on this site, please contact
        me at
        <a
          href="mailto:david@woitzik.dev"
          class="text-sky-600 dark:text-sky-400 hover:underline"
          >david@woitzik.dev</a
        >. I reply to accessibility reports within 48 hours.
      </p>

      <p class="text-xs text-neutral-400 dark:text-neutral-500">
        Last updated: July 2026
      </p>
    </div>
  </Container>
</PageLayout>
