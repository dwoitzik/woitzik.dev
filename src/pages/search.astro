---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import PageHeader from "@components/PageHeader.astro";
---

<PageLayout
  title="Search"
  description="Search articles and tools on woitzik.dev"
  noindex
>
  <Container>
    <PageHeader
      eyebrow="Search"
      title="Search"
      description="Full-text search across every article, project and tool page. Error messages work well as queries."
    />
    <div id="pagefind-search" class="animate max-w-3xl"></div>
  </Container>
</PageLayout>

<style is:global>
  /* Pagefind is themed through its own CSS variables, mapped to the site
     palette (zinc greys, teal accent). */
  #pagefind-search {
    --pagefind-ui-scale: 0.85;
    --pagefind-ui-primary: #0f766e;
    --pagefind-ui-text: #18181b;
    --pagefind-ui-background: #ffffff;
    --pagefind-ui-border: rgba(24, 24, 27, 0.12);
    --pagefind-ui-tag: #f4f4f5;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 12px;
    --pagefind-ui-font: inherit;
  }
  .dark #pagefind-search {
    --pagefind-ui-primary: #2dd4bf;
    --pagefind-ui-text: #e4e4e7;
    --pagefind-ui-background: #0f0f12;
    --pagefind-ui-border: rgba(255, 255, 255, 0.1);
    --pagefind-ui-tag: #18181b;
  }
  #pagefind-search .pagefind-ui__search-input:focus {
    outline: 2px solid rgba(20, 184, 166, 0.35);
    outline-offset: 0;
  }
  #pagefind-search .pagefind-ui__result-link {
    text-decoration: none;
  }
  #pagefind-search .pagefind-ui__result-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  #pagefind-search .pagefind-ui__result-excerpt {
    color: #71717a;
  }
  .dark #pagefind-search .pagefind-ui__result-excerpt {
    color: #a1a1aa;
  }
  #pagefind-search mark {
    background: rgba(20, 184, 166, 0.18);
    color: inherit;
    border-radius: 2px;
  }
</style>

<script is:inline>
  function loadScript(src, id) {
    return new Promise(function (resolve, reject) {
      if (document.getElementById(id)) {
        resolve();
        return;
      }
      var s = document.createElement("script");
      s.id = id;
      s.src = src;
      s.onload = resolve;
      s.onerror = reject;
      document.head.appendChild(s);
    });
  }

  function initSearch() {
    var el = document.getElementById("pagefind-search");
    if (!el) return;
    el.innerHTML = "";

    if (!document.getElementById("pagefind-css")) {
      var link = document.createElement("link");
      link.id = "pagefind-css";
      link.rel = "stylesheet";
      link.href = "/pagefind/pagefind-ui.css";
      document.head.appendChild(link);
    }

    loadScript("/pagefind/pagefind-ui.js", "pagefind-script")
      .then(function () {
        var ui = new window.PagefindUI({
          element: "#pagefind-search",
          showSubResults: false,
          showImages: false,
          resetStyles: false,
        });
        // /search/?q=term runs the query on load. The WebSite SearchAction in
        // Head.astro points crawlers and browser keyword search at this URL.
        var query = new URLSearchParams(window.location.search).get("q");
        if (query) ui.triggerSearch(query);
        const input = el.querySelector("input");
        if (input) input.focus();
      })
      .catch(function () {
        el.innerHTML = `<p class="text-sm text-neutral-500">Search is not available in this environment.</p>`;
      });
  }

  initSearch();
  document.addEventListener("astro:after-swap", initSearch);
</script>
