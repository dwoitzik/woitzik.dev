---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import PageHeader from "@components/PageHeader.astro";
import EmailCapture from "@components/EmailCapture.astro";
import { products } from "@data/products";

const foundationSlug = "hub-spoke-enterprise-vnet";
---

<PageLayout
  title="Open Source Modules"
  description="Free, MIT-licensed Terraform modules for Azure environments under ISO 27001, NIS2, and KRITIS: Zero-Trust networking, Private Link, and Managed Identity."
>
  <Container>
    <div class="space-y-5">
      <PageHeader
        eyebrow="Terraform modules"
        title="Open source modules for Azure"
        description="Terraform modules for Azure environments that have to meet ISO 27001, NIS2 or KRITIS controls. Each one is documented, free and MIT licensed."
      >
        <p class="mt-3 text-sm text-pretty">
          New to this stack? Start with the <strong
            class="text-zinc-950 dark:text-white">Hub &amp; Spoke</strong
          > foundation. The Firewall and the other modules are built to drop into
          it.
        </p>
      </PageHeader>

      <div class="grid gap-5 lg:grid-cols-2">
        {
          products.map((product) => (
            <article class="not-prose animate flex flex-col rounded-xl border border-zinc-900/[0.08] dark:border-white/[0.08] bg-white dark:bg-white/[0.02] overflow-hidden">
              <div class="px-6 pt-6 pb-4 flex flex-wrap gap-4 items-start justify-between">
                <div class="space-y-2">
                  <div class="flex items-center gap-1.5 flex-wrap">
                    {product.slug === foundationSlug && (
                      <span class="rounded bg-teal-500/10 px-2 py-0.5 text-xs font-semibold text-teal-700 dark:text-teal-400">
                        Start here
                      </span>
                    )}
                    {product.tags.slice(0, 3).map((tag) => (
                      <span class="rounded bg-zinc-900/[0.04] px-1.5 py-0.5 text-[0.7rem] text-zinc-500 dark:bg-white/[0.05] dark:text-zinc-400">
                        {tag}
                      </span>
                    ))}
                  </div>
                  <h2 class="text-lg font-semibold tracking-tight text-zinc-950 dark:text-white">
                    {product.title}
                  </h2>
                  <p class="text-sm text-black/60 dark:text-white/60 max-w-xl leading-relaxed">
                    {product.description}
                  </p>
                </div>

                <span class="shrink-0 rounded-full bg-emerald-500/10 px-2 py-0.5 text-[0.7rem] font-semibold text-emerald-700 dark:text-emerald-400">
                  Free, MIT
                </span>
              </div>

              <div class="px-6 pb-4">
                <ul class="space-y-1.5">
                  {product.bullets.map((b) => (
                    <li class="flex items-start gap-2 text-sm text-black/70 dark:text-white/70">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="13"
                        height="13"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="mt-0.5 shrink-0 opacity-70"
                      >
                        <polyline points="20 6 9 17 4 12" />
                      </svg>
                      {b}
                    </li>
                  ))}
                </ul>
              </div>

              <div class="mt-auto px-6 py-4 border-t border-black/10 dark:border-white/10 flex flex-wrap gap-3 items-center">
                <a
                  href={product.repoHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-sm font-semibold px-4 py-2 rounded bg-black dark:bg-white text-white dark:text-black hover:opacity-80 transition-opacity"
                >
                  View on GitHub &rarr;
                </a>
                {product.registryHref && (
                  <a
                    href={product.registryHref}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 text-sm font-semibold px-4 py-2 rounded border border-black/15 dark:border-white/20 hover:opacity-80 transition-opacity"
                  >
                    Terraform Registry &rarr;
                  </a>
                )}
                {product.articleHref !== "/templates" && (
                  <a
                    href={product.articleHref}
                    class="text-sm font-medium text-zinc-600 hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-white transition-colors"
                  >
                    Read the write-up
                  </a>
                )}
              </div>
            </article>
          ))
        }
      </div>

      <!-- License & Trust signals -->
      <div
        class="animate rounded-lg border border-black/10 dark:border-white/10 px-6 py-5 space-y-2"
      >
        <p class="text-xs font-bold uppercase tracking-widest opacity-40">
          License
        </p>
        <ul class="space-y-1.5 text-sm text-black/60 dark:text-white/60">
          <li>MIT licensed, full Terraform source, no lock-in</li>
          <li>Use it in your own infrastructure or for client work</li>
          <li>
            Questions? <a
              href="mailto:david@woitzik.dev"
              class="underline underline-offset-2 hover:opacity-80 transition-opacity"
              >david@woitzik.dev</a
            >
          </li>
        </ul>
      </div>

      <!-- Lead magnet -->
      <div
        class="animate rounded-lg border border-teal-500/20 bg-teal-500/5 px-6 py-5 space-y-3"
      >
        <div class="flex items-center gap-2 flex-wrap">
          <span
            class="text-xs font-bold px-2 py-0.5 rounded bg-teal-500/10 text-teal-600 dark:text-teal-400 border border-teal-500/20"
          >
            Free download
          </span>
        </div>
        <h2
          class="text-lg font-semibold tracking-tight text-zinc-950 dark:text-white"
        >
          ISO 27001 Auditor Checklist
        </h2>
        <p
          class="text-sm text-black/60 dark:text-white/60 max-w-xl leading-relaxed"
        >
          The ISO 27001 Annex A controls I check when I harden an Azure
          deployment for ISO 27001, NIS2, or KRITIS: network isolation,
          identity, logging, and the rest. One-page PDF, no email required.
        </p>
        <a
          href="/downloads/iso27001-auditor-checklist.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-sm font-semibold px-4 py-2 rounded bg-black dark:bg-white text-white dark:text-black hover:opacity-80 transition-opacity"
        >
          Download the checklist (PDF) &rarr;
        </a>
      </div>

      <div class="animate">
        <EmailCapture
          title="New modules and articles"
          description="An email when a new module or article goes out. No spam, unsubscribe anytime."
        />
      </div>
    </div>
  </Container>
</PageLayout>
