---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";

export async function getStaticPaths() {
  const projects = (await getCollection("projects"))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: project,
  }));
}
type Props = CollectionEntry<"projects">;

const project = Astro.props;
const { Content } = await project.render();

const projectUrl = `https://woitzik.dev/projects/${project.slug}/`;

// Project pages are long-form writeups of a module or build, so they get the
// same article node as blog posts. The repository is linked as a
// SoftwareSourceCode node only where a public repo exists.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "@id": `${projectUrl}#article`,
  headline: project.data.title,
  description: project.data.description,
  datePublished: project.data.date.toISOString(),
  dateModified: project.data.date.toISOString(),
  author: {
    "@type": "Person",
    "@id": "https://woitzik.dev/#person",
    name: "David Woitzik",
    url: "https://woitzik.dev/",
  },
  publisher: { "@id": "https://woitzik.dev/#person" },
  image: {
    "@type": "ImageObject",
    url: "https://woitzik.dev/og/default.png",
    width: 1200,
    height: 630,
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": projectUrl },
  isPartOf: { "@id": "https://woitzik.dev/#website" },
  url: projectUrl,
  inLanguage: "en",
  ...(project.data.repoURL
    ? {
        about: {
          "@type": "SoftwareSourceCode",
          name: project.data.title,
          codeRepository: project.data.repoURL,
        },
      }
    : {}),
};

// Mirrors the rendered breadcrumb nav. The last item is the current page and
// carries no `item`, same as the blog breadcrumb.
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://woitzik.dev/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Projects",
      item: "https://woitzik.dev/projects/",
    },
    { "@type": "ListItem", position: 3, name: project.data.title },
  ],
};
---

<PageLayout title={project.data.title} description={project.data.description}>
  <Container>
    <div class="max-w-[46rem]">
      <nav class="animate mb-8 text-xs text-zinc-500" aria-label="Breadcrumb">
        <ol class="flex min-w-0 items-center gap-1.5 whitespace-nowrap">
          <li class="shrink-0">
            <a
              href="/"
              class="hover:text-zinc-950 dark:hover:text-white transition-colors"
              >Home</a
            >
          </li>
          <li aria-hidden="true" class="shrink-0 opacity-50">/</li>
          <li class="shrink-0">
            <a
              href="/projects/"
              class="hover:text-zinc-950 dark:hover:text-white transition-colors"
              >Projects</a
            >
          </li>
          <li aria-hidden="true" class="shrink-0 opacity-50">/</li>
          <li
            class="min-w-0 truncate text-zinc-700 dark:text-zinc-300"
            aria-current="page"
          >
            {project.data.title}
          </li>
        </ol>
      </nav>
      <div
        class="animate flex flex-wrap items-center gap-2 font-mono text-xs text-zinc-500"
      >
        <FormattedDate date={project.data.date} />
        <span aria-hidden="true" class="opacity-50">/</span>
        <span>{readingTime(project.body)}</span>
      </div>
      <h1
        class="animate mt-3 text-3xl font-bold leading-[1.15] tracking-tight text-zinc-950 dark:text-white sm:text-[2.6rem]"
      >
        {project.data.title}
      </h1>
      <p
        class="animate mt-5 text-lg leading-relaxed text-zinc-700 dark:text-zinc-300"
      >
        {project.data.description}
      </p>
      {
        (project.data.demoURL || project.data.repoURL) && (
          <div class="animate mt-6 flex flex-wrap gap-3">
            {project.data.repoURL && (
              <a
                href={project.data.repoURL}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-lg bg-zinc-950 px-4 py-2.5 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5 dark:bg-white dark:text-zinc-950"
              >
                Source on GitHub &rarr;
              </a>
            )}
            {project.data.demoURL && (
              <a
                href={project.data.demoURL}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-lg border border-zinc-900/15 px-4 py-2.5 text-sm font-semibold text-zinc-950 hover:bg-zinc-900/[0.04] dark:border-white/15 dark:text-white dark:hover:bg-white/[0.05]"
              >
                Live demo
              </a>
            )}
          </div>
        )
      }
      <hr
        class="animate mt-8 mb-10 border-zinc-900/[0.07] dark:border-white/[0.07]"
      />
      <article class="animate">
        <Content />
      </article>
    </div>
  </Container>
</PageLayout>

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(jsonLd)}
/>

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(breadcrumbLd)}
/>
