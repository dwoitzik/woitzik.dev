---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";

export async function getStaticPaths() {
  const projects = (await getCollection("projects"))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: project,
  }));
}
type Props = CollectionEntry<"projects">;

const project = Astro.props;
const { Content } = await project.render();
---

<PageLayout title={project.data.title} description={project.data.description}>
  <Container>
    <div class="max-w-[46rem]">
      <nav class="animate mb-8 text-xs text-zinc-500" aria-label="Breadcrumb">
        <ol class="flex min-w-0 items-center gap-1.5 whitespace-nowrap">
          <li class="shrink-0">
            <a
              href="/"
              class="hover:text-zinc-950 dark:hover:text-white transition-colors"
              >Home</a
            >
          </li>
          <li aria-hidden="true" class="shrink-0 opacity-50">/</li>
          <li class="shrink-0">
            <a
              href="/projects/"
              class="hover:text-zinc-950 dark:hover:text-white transition-colors"
              >Projects</a
            >
          </li>
          <li aria-hidden="true" class="shrink-0 opacity-50">/</li>
          <li
            class="min-w-0 truncate text-zinc-700 dark:text-zinc-300"
            aria-current="page"
          >
            {project.data.title}
          </li>
        </ol>
      </nav>
      <div
        class="animate flex flex-wrap items-center gap-2 font-mono text-xs text-zinc-500"
      >
        <FormattedDate date={project.data.date} />
        <span aria-hidden="true" class="opacity-50">/</span>
        <span>{readingTime(project.body)}</span>
      </div>
      <h1
        class="animate mt-3 text-3xl font-bold leading-[1.15] tracking-tight text-zinc-950 dark:text-white sm:text-[2.6rem]"
      >
        {project.data.title}
      </h1>
      <p
        class="animate mt-5 text-lg leading-relaxed text-zinc-700 dark:text-zinc-300"
      >
        {project.data.description}
      </p>
      {
        (project.data.demoURL || project.data.repoURL) && (
          <div class="animate mt-6 flex flex-wrap gap-3">
            {project.data.repoURL && (
              <a
                href={project.data.repoURL}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-lg bg-zinc-950 px-4 py-2.5 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5 dark:bg-white dark:text-zinc-950"
              >
                Source on GitHub &rarr;
              </a>
            )}
            {project.data.demoURL && (
              <a
                href={project.data.demoURL}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-lg border border-zinc-900/15 px-4 py-2.5 text-sm font-semibold text-zinc-950 hover:bg-zinc-900/[0.04] dark:border-white/15 dark:text-white dark:hover:bg-white/[0.05]"
              >
                Live demo
              </a>
            )}
          </div>
        )
      }
      <hr
        class="animate mt-8 mb-10 border-zinc-900/[0.07] dark:border-white/[0.07]"
      />
      <article class="animate">
        <Content />
      </article>
    </div>
  </Container>
</PageLayout>
