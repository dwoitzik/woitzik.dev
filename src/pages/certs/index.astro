---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import PageHeader from "@components/PageHeader.astro";
import { dateRange } from "@lib/utils";
import { CERTS } from "@consts";
import { Image } from "astro:assets";

const collection = (await getCollection("certs"))
  .filter((item) => !item.data.draft)
  .sort(
    (a, b) =>
      new Date(b.data.dateStart).valueOf() -
      new Date(a.data.dateStart).valueOf(),
  );

const certs = await Promise.all(
  collection.map(async (item) => {
    const { Content } = await item.render();
    return { ...item, Content };
  }),
);
---

<PageLayout title={CERTS.TITLE} description={CERTS.DESCRIPTION}>
  <Container>
    <PageHeader
      eyebrow="Certifications"
      title="Certifications"
      description="Current Microsoft and HashiCorp certifications. The work behind them is in the blog and the Terraform modules."
    />
    <ul class="animate grid gap-4 sm:grid-cols-2">
      {
        certs.map((entry) => (
          <li class="flex gap-5 rounded-xl border border-zinc-900/[0.08] dark:border-white/[0.08] bg-white dark:bg-white/[0.02] p-5 sm:p-6">
            {entry.data.image && (
              <div class="grid size-20 shrink-0 place-items-center rounded-xl bg-zinc-100 p-2 dark:bg-white/[0.05]">
                <Image
                  src={entry.data.image}
                  alt={`${entry.data.company} badge`}
                  class="size-full object-contain"
                />
              </div>
            )}
            <div class="min-w-0">
              <p class="font-mono text-xs uppercase tracking-wider text-teal-700 dark:text-teal-400">
                {entry.data.company}
              </p>
              <h2 class="mt-1.5 font-semibold leading-snug text-zinc-950 dark:text-white">
                {entry.data.role}
              </h2>
              <p class="mt-2 font-mono text-xs text-zinc-500">
                {entry.data.dateEnd
                  ? `Valid ${dateRange(entry.data.dateStart, entry.data.dateEnd)}`
                  : `Issued ${new Date(entry.data.dateStart).toLocaleDateString("en-US", { month: "short", year: "numeric" })}`}
              </p>
              <div class="prose prose-sm prose-zinc mt-3 max-w-none dark:prose-invert">
                <entry.Content />
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </Container>
</PageLayout>
