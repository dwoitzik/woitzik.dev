---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ProjectCard from "@components/ProjectCard.astro";
import PostList from "@components/PostList.astro";
import { HOME } from "@consts";
import { products } from "@data/products";
import EmailCapture from "@components/EmailCapture.astro";

const blog = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => {
    if (a.data.pinned && !b.data.pinned) return -1;
    if (!a.data.pinned && b.data.pinned) return 1;
    return b.data.date.valueOf() - a.data.date.valueOf();
  });

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const certs = (await getCollection("certs"))
  .filter((cert) => !cert.data.draft)
  .sort(
    (a, b) =>
      new Date(b.data.dateStart).valueOf() -
      new Date(a.data.dateStart).valueOf(),
  );

const modules = products.filter((p) => p.available);
const latest = blog.slice(0, 5);

// Every figure here is counted from the content collections at build time,
// so it can't drift from what the site actually contains.
const stats = [
  { value: blog.length, label: "articles" },
  { value: modules.length, label: "free Terraform modules" },
  { value: certs.length, label: "certifications" },
];

const stack = [
  "Azure",
  "Terraform",
  "Kubernetes",
  "Proxmox",
  "Ansible",
  "MikroTik",
];

const sectionHead =
  "flex items-end justify-between gap-4 border-b border-zinc-900/[0.07] dark:border-white/[0.07] pb-3";
const sectionTitle =
  "text-sm font-semibold uppercase tracking-wider text-zinc-950 dark:text-white";
const viewAll =
  "text-sm font-medium text-teal-700 dark:text-teal-400 hover:text-teal-800 dark:hover:text-teal-300 transition-colors";
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <!-- Hero -->
    <section class="relative">
      <div
        class="pointer-events-none absolute -top-24 left-1/2 -z-10 h-72 w-[42rem] max-w-full -translate-x-1/2 rounded-full bg-teal-500/10 blur-3xl dark:bg-teal-400/[0.07]"
        aria-hidden="true"
      >
      </div>

      <div class="animate">
        <p
          class="inline-flex items-center gap-2 rounded-full border border-zinc-900/10 dark:border-white/10 bg-white/70 dark:bg-white/[0.03] px-3 py-1 text-xs font-medium text-zinc-600 dark:text-zinc-400"
        >
          <span class="size-1.5 rounded-full bg-teal-500"></span>
          Hybrid Cloud Engineer
        </p>
        <h1
          class="mt-5 text-4xl font-bold tracking-tight text-zinc-950 dark:text-white sm:text-5xl"
        >
          David Woitzik
        </h1>
        <p
          class="mt-4 max-w-2xl text-lg leading-relaxed text-zinc-700 dark:text-zinc-300 sm:text-xl"
        >
          I build Azure infrastructure for environments that have to pass ISO
          27001, NIS2 and KRITIS audits, and run a homelab where I find out what
          breaks first.
        </p>
        <p class="mt-3 max-w-2xl leading-relaxed">
          Here I publish the Terraform modules and the write-ups I wanted when I
          was solving the same problems: what failed, why, and the fix that
          held.
        </p>
      </div>

      <div class="animate mt-8 flex flex-wrap items-center gap-3">
        <a
          href="/blog/"
          class="inline-flex items-center gap-2 rounded-lg bg-zinc-950 dark:bg-white px-4 py-2.5 text-sm font-semibold text-white dark:text-zinc-950 shadow-sm transition-transform hover:-translate-y-0.5"
        >
          Read the blog <span aria-hidden="true">&rarr;</span>
        </a>
        <a
          href="/templates/"
          class="inline-flex items-center gap-2 rounded-lg border border-zinc-900/15 dark:border-white/15 px-4 py-2.5 text-sm font-semibold text-zinc-950 dark:text-white transition-colors hover:bg-zinc-900/[0.04] dark:hover:bg-white/[0.05]"
        >
          Terraform modules
        </a>
        <a
          href="https://github.com/dwoitzik"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="grid size-10 place-items-center rounded-lg text-zinc-500 transition-colors hover:bg-zinc-900/[0.04] hover:text-zinc-950 dark:hover:bg-white/[0.05] dark:hover:text-white"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
            ></path>
          </svg>
        </a>
      </div>

      <dl
        class="animate mt-12 grid grid-cols-3 divide-x divide-zinc-900/[0.07] dark:divide-white/[0.07] rounded-xl border border-zinc-900/[0.07] dark:border-white/[0.07] bg-white/60 dark:bg-white/[0.02]"
      >
        {
          stats.map((s) => (
            <div class="px-4 py-4 sm:px-6">
              <dt class="sr-only">{s.label}</dt>
              <dd class="text-2xl font-semibold tracking-tight text-zinc-950 dark:text-white tabular-nums">
                {s.value}
              </dd>
              <dd class="mt-0.5 text-xs leading-snug sm:text-sm">{s.label}</dd>
            </div>
          ))
        }
      </dl>

      <ul class="animate mt-6 flex flex-wrap gap-2" aria-label="Tech stack">
        {
          stack.map((name) => (
            <li class="rounded-md border border-zinc-900/[0.08] dark:border-white/[0.08] px-2.5 py-1 font-mono text-xs text-zinc-600 dark:text-zinc-400">
              {name}
            </li>
          ))
        }
      </ul>
    </section>

    <div class="mt-20 space-y-20">
      <!-- Latest writing -->
      {
        latest.length > 0 && (
          <section class="animate">
            <div class={sectionHead}>
              <h2 class={sectionTitle}>Latest writing</h2>
              <a href="/blog/" class={viewAll}>
                All {blog.length} articles &rarr;
              </a>
            </div>
            <PostList posts={latest} />
          </section>
        )
      }

      <!-- Modules -->
      <section class="animate">
        <div class={sectionHead}>
          <h2 class={sectionTitle}>Free Terraform modules</h2>
          <a href="/templates/" class={viewAll}>Details &rarr;</a>
        </div>
        <p class="mt-4 max-w-2xl text-sm leading-relaxed">
          MIT licensed and published on the Terraform Registry. Each one has a
          write-up that explains the design decisions.
        </p>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {
            modules.map((product) => (
              <div class="group flex flex-col rounded-xl border border-zinc-900/[0.08] dark:border-white/[0.08] bg-white dark:bg-white/[0.02] p-5 transition-all hover:-translate-y-0.5 hover:border-teal-500/40 hover:shadow-lg hover:shadow-teal-500/[0.04]">
                <div class="flex items-start justify-between gap-3">
                  <h3 class="font-semibold leading-snug text-zinc-950 dark:text-white">
                    {product.title}
                  </h3>
                  <span class="shrink-0 rounded-full bg-emerald-500/10 px-2 py-0.5 text-[0.7rem] font-semibold text-emerald-700 dark:text-emerald-400">
                    Free
                  </span>
                </div>
                <p class="mt-2 line-clamp-3 text-sm leading-relaxed">
                  {product.description}
                </p>
                <div class="mt-3 flex flex-wrap gap-1.5">
                  {product.tags.slice(0, 3).map((tag) => (
                    <span class="rounded bg-zinc-900/[0.04] px-1.5 py-0.5 text-[0.7rem] text-zinc-500 dark:bg-white/[0.05] dark:text-zinc-400">
                      {tag}
                    </span>
                  ))}
                </div>
                <div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-2 pt-5 text-sm font-medium">
                  <a
                    href={product.repoHref}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-zinc-950 hover:text-teal-700 dark:text-white dark:hover:text-teal-400 transition-colors"
                  >
                    GitHub &rarr;
                  </a>
                  {product.registryHref && (
                    <a
                      href={product.registryHref}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="hover:text-zinc-950 dark:hover:text-white transition-colors"
                    >
                      Registry
                    </a>
                  )}
                  {product.articleHref && (
                    <a
                      href={product.articleHref}
                      class="hover:text-zinc-950 dark:hover:text-white transition-colors"
                    >
                      Write-up
                    </a>
                  )}
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <div class="animate">
        <EmailCapture
          title="Free: Azure Zero-Trust Terraform Cheat Sheet"
          description="8 production-ready patterns for NSGs, Private Endpoints, Forced Tunneling, and Managed Identities. Sent to your inbox as soon as you confirm your address."
          buttonText="Send me the cheat sheet"
          successMessage="Almost done: check your inbox and confirm. The cheat sheet arrives right after."
        />
      </div>

      <div
        class="grid gap-16 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)] lg:gap-10"
      >
        {
          projects.length > 0 && (
            <section class="animate">
              <div class={sectionHead}>
                <h2 class={sectionTitle}>Projects</h2>
                <a href="/projects/" class={viewAll}>
                  All &rarr;
                </a>
              </div>
              <div class="mt-6 grid gap-3">
                {projects.slice(0, 2).map((project) => (
                  <ProjectCard entry={project} />
                ))}
              </div>
            </section>
          )
        }

        {
          certs.length > 0 && (
            <section class="animate">
              <div class={sectionHead}>
                <h2 class={sectionTitle}>Certifications</h2>
                <a href="/certs/" class={viewAll}>
                  All &rarr;
                </a>
              </div>
              <ul class="mt-6 grid gap-3">
                {certs.map((cert) => (
                  <li class="flex items-center gap-3 rounded-xl border border-zinc-900/[0.08] dark:border-white/[0.08] bg-white dark:bg-white/[0.02] p-3">
                    {cert.data.image && (
                      <div class="size-10 shrink-0 rounded-lg bg-zinc-100 p-1.5 dark:bg-white/[0.06]">
                        <img
                          src={cert.data.image.src}
                          alt=""
                          class="size-full object-contain"
                          loading="lazy"
                        />
                      </div>
                    )}
                    <div class="min-w-0">
                      <div class="text-[0.65rem] font-semibold uppercase tracking-wider text-zinc-500">
                        {cert.data.company}
                      </div>
                      <div class="text-sm font-medium leading-snug text-zinc-950 dark:text-white">
                        {cert.data.role}
                      </div>
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>
    </div>
  </Container>
</PageLayout>
