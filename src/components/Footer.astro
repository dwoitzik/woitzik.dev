---
import Container from "@components/Container.astro";
import { SITE } from "@consts";

const columns = [
  {
    title: "Read",
    links: [
      { href: "/blog/", label: "Blog" },
      { href: "/projects/", label: "Projects" },
      { href: "/rss.xml", label: "RSS" },
    ],
  },
  {
    title: "Build",
    links: [
      { href: "/templates/", label: "Terraform modules" },
      { href: "/tools/", label: "Tools" },
      { href: "https://github.com/dwoitzik", label: "GitHub", external: true },
    ],
  },
  {
    title: "Contact",
    links: [
      { href: `mailto:${SITE.EMAIL}`, label: "Email" },
      {
        href: "https://linkedin.com/in/david-woitzik",
        label: "LinkedIn",
        external: true,
      },
      {
        href: "https://github.com/sponsors/dwoitzik",
        label: "Sponsor",
        external: true,
      },
      { href: SITE.SUPPORT_URL, label: "Buy me a coffee", external: true },
    ],
  },
];

const themeButton =
  "grid size-7 place-items-center rounded-md text-zinc-500 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white hover:bg-zinc-900/[0.05] dark:hover:bg-white/[0.07] transition-colors";
---

<footer
  class="animate border-t border-zinc-900/[0.06] dark:border-white/[0.06] bg-white/50 dark:bg-white/[0.015]"
>
  <Container>
    <div class="grid gap-10 py-12 sm:grid-cols-[1.4fr_repeat(3,1fr)]">
      <div class="space-y-3">
        <a href="/" class="flex items-center gap-2 w-fit">
          <span
            class="grid size-7 place-items-center rounded-lg bg-zinc-950 dark:bg-white text-white dark:text-zinc-950 font-mono text-[0.7rem] font-bold"
            aria-hidden="true">dw</span
          >
          <span
            class="font-semibold tracking-tight text-zinc-950 dark:text-white"
            >{SITE.NAME}</span
          >
        </a>
        <p class="max-w-xs text-sm leading-relaxed">
          Write-ups from a real homelab and free Terraform modules for Azure.
        </p>
      </div>

      {
        columns.map((col) => (
          <div>
            <h2 class="mb-3 text-xs font-semibold uppercase tracking-wider text-zinc-950 dark:text-white">
              {col.title}
            </h2>
            <ul class="space-y-2">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    {...(link.external
                      ? { target: "_blank", rel: "noopener noreferrer" }
                      : {})}
                    class="text-sm hover:text-zinc-950 dark:hover:text-white transition-colors"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="flex flex-col-reverse gap-4 border-t border-zinc-900/[0.06] dark:border-white/[0.06] py-6 text-xs sm:flex-row sm:items-center sm:justify-between"
    >
      <div class="space-y-1">
        <p>
          &copy; {new Date().getFullYear()}
          {SITE.NAME} &middot;
          <a
            href="/legal/"
            class="hover:text-zinc-950 dark:hover:text-white transition-colors"
            >Legal &amp; Privacy</a
          > &middot;
          <a
            href="/accessibility/"
            class="hover:text-zinc-950 dark:hover:text-white transition-colors"
            >Accessibility</a
          >
        </p>
        <p>As an Amazon Associate I earn from qualifying purchases.</p>
      </div>

      <div
        class="flex w-fit items-center gap-0.5 rounded-lg border border-zinc-900/10 dark:border-white/10 p-0.5"
        role="group"
        aria-label="Theme"
      >
        <button
          id="light-theme-button"
          aria-label="Light theme"
          class={themeButton}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4.5"></circle>
            <path
              d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            ></path>
          </svg>
        </button>
        <button
          id="dark-theme-button"
          aria-label="Dark theme"
          class={themeButton}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
        <button
          id="system-theme-button"
          aria-label="System theme"
          class={themeButton}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="2" y="3" width="20" height="14" rx="2"></rect>
            <path d="M8 21h8M12 17v4"></path>
          </svg>
        </button>
      </div>
    </div>
  </Container>
</footer>
