---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "@lib/utils";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
};

const { entry } = Astro.props;
const date = "date" in entry.data ? entry.data.date : null;
const updated = "updated" in entry.data ? entry.data.updated : null;
const lang = "lang" in entry.data ? entry.data.lang : "en";
const pinned = "pinned" in entry.data ? entry.data.pinned : false;
---

<a
  href={`/${entry.collection}/${entry.slug}/`}
  class="relative group flex flex-nowrap min-w-0 py-4 px-4 pr-11 rounded-xl border border-zinc-900/[0.08] dark:border-white/[0.08] bg-white dark:bg-white/[0.02] hover:border-teal-500/40 hover:text-zinc-950 dark:hover:text-white transition-colors duration-300 ease-in-out"
>
  <div class="flex flex-col flex-1 min-w-0">
    <div class="flex items-center gap-2 flex-wrap">
      {
        pinned && (
          <span class="text-[0.6rem] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded bg-sky-500/10 text-sky-700 dark:text-sky-400 shrink-0">
            Pinned
          </span>
        )
      }
      <div class="font-semibold text-zinc-950 dark:text-white">
        {entry.data.title}
      </div>
      {
        date && (
          <div class="text-xs opacity-40 shrink-0">
            {formatDate(date, lang)}
            {updated && (
              <span class="ml-1" title={`Updated ${formatDate(updated, lang)}`}>
                (updated)
              </span>
            )}
          </div>
        )
      }
    </div>
    <div class="text-sm mt-1 truncate">
      {entry.data.description}
    </div>
  </div>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    class="absolute top-1/2 right-2 -translate-y-1/2 size-5 stroke-2 fill-none stroke-current"
  >
    <line
      x1="5"
      y1="12"
      x2="19"
      y2="12"
      class="translate-x-3 group-hover:translate-x-0 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 ease-in-out"
    ></line>
    <polyline
      points="12 5 19 12 12 19"
      class="-translate-x-1 group-hover:translate-x-0 transition-transform duration-300 ease-in-out"
    ></polyline>
  </svg>
</a>
