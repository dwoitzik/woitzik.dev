---
import { SITE } from "@consts";
---

<aside
  class="not-prose my-6 flex flex-wrap sm:flex-nowrap items-center justify-between gap-4 rounded-xl border border-zinc-900/[0.08] dark:border-white/[0.08] bg-white/60 dark:bg-white/[0.02] px-5 py-4"
>
  <div class="min-w-0">
    <p class="font-semibold text-black dark:text-white text-sm m-0">
      Found this useful?
    </p>
    <p class="text-sm text-neutral-500 dark:text-neutral-400 mt-1 m-0">
      Each of these posts takes hours to write and test. A coffee helps keep
      them free.
    </p>
  </div>
  <a
    href={SITE.SUPPORT_URL}
    target="_blank"
    rel="noopener noreferrer"
    data-support-cta
    class="shrink-0 inline-flex items-center gap-2 rounded-lg border border-zinc-900/15 dark:border-white/15 px-4 py-2 text-sm font-semibold text-zinc-950 dark:text-white hover:bg-zinc-900/[0.04] dark:hover:bg-white/[0.06] transition-colors"
  >
    Buy me a coffee
  </a>
</aside>

<script>
  function trackSupportClick() {
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>("a[data-support-cta]"),
    );
    links.forEach((el) => {
      if (el.dataset.tracking) return;
      el.dataset.tracking = "1";
      el.addEventListener("click", () => {
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const analytics = window as any;
        if (typeof analytics.va === "function") {
          analytics.va("event", {
            name: "support_click",
            data: { page: location.pathname },
          });
        }
        if (analytics.rybbit && typeof analytics.rybbit.event === "function") {
          analytics.rybbit.event("support_click", {
            page: location.pathname,
          });
        }
      });
    });
  }

  document.addEventListener("astro:page-load", trackSupportClick);
</script>
