---
interface Testimonial {
  quote: string;
  name: string;
  role?: string;
}

interface Props {
  testimonials?: Testimonial[];
}

const { testimonials = [] } = Astro.props;
---

{
  testimonials.length > 0 && (
    <div class="not-prose my-12">
      <h3 class="text-sm font-semibold uppercase tracking-wider text-neutral-400 dark:text-neutral-500 mb-6">
        What buyers say
      </h3>
      <div class="grid gap-4 md:grid-cols-2">
        {testimonials.map((t) => (
          <blockquote class="rounded-lg border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900/50 p-5">
            <p class="text-sm text-neutral-700 dark:text-neutral-300 m-0">
              &ldquo;{t.quote}&rdquo;
            </p>
            <footer class="mt-3 text-xs font-semibold text-neutral-500 dark:text-neutral-400">
              &mdash; {t.name}
              {t.role ? `, ${t.role}` : ""}
            </footer>
          </blockquote>
        ))}
      </div>
    </div>
  )
}
