---
interface Props {
  title?: string;
  description?: string;
  buttonText?: string;
  successMessage?: string;
}

const {
  title = "Stay in the loop",
  description = "New Terraform modules and articles by email. No spam.",
  buttonText = "Subscribe",
  successMessage = "Check your inbox for the welcome email.",
} = Astro.props;
---

<div
  class="relative overflow-hidden rounded-2xl border border-zinc-900/[0.08] dark:border-white/[0.08] bg-gradient-to-br from-white to-teal-50/60 dark:from-white/[0.03] dark:to-teal-400/[0.05] p-6 sm:p-8"
>
  <div class="mb-4">
    <h3
      class="text-lg font-semibold tracking-tight text-zinc-950 dark:text-white"
    >
      {title}
    </h3>
    <p
      class="mt-1.5 max-w-xl text-sm leading-relaxed text-zinc-600 dark:text-zinc-400"
    >
      {description}
    </p>
  </div>

  <form
    id="email-capture-form"
    class="flex flex-col sm:flex-row gap-2"
    data-success-message={successMessage}
  >
    <input
      type="email"
      name="email"
      required
      aria-label="Email address"
      autocomplete="email"
      placeholder="you@company.com"
      class="flex-1 rounded-lg border border-zinc-900/15 dark:border-white/15 bg-white dark:bg-zinc-950/60 px-3.5 py-2.5 text-sm text-zinc-950 dark:text-white placeholder-zinc-400 dark:placeholder-zinc-500 focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-500/20"
    />
    <button
      type="submit"
      class="shrink-0 rounded-lg bg-zinc-950 dark:bg-white px-4 py-2.5 text-sm font-semibold text-white dark:text-zinc-950 transition-opacity hover:opacity-85"
    >
      {buttonText}
    </button>
  </form>

  <p id="email-capture-message" class="hidden text-sm mt-3"></p>
</div>

<script>
  // Module scripts execute exactly once per browser session per the JS spec.
  // With Astro's ClientRouter (view transitions) enabled, navigating between
  // pages doesn't reload the page - so a plain top-level script only wires up
  // the FIRST EmailCapture instance the user happens to land on; any later
  // page in the same session with its own EmailCapture gets no submit handler
  // and silently falls back to a native form submit (looks like a refresh).
  // astro:page-load fires on every navigation, including the initial one -
  // re-running setup here keeps the handler attached every time.

  // Fires on the confirmed subscription, not on the button press: a rejected
  // address or a Brevo outage is not a conversion, and counting those as
  // signups would inflate the funnel. The address itself is never sent to
  // analytics, only the page it was submitted from.
  function trackSubscription() {
    const page = location.pathname;
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const analytics = window as any;
    if (typeof analytics.va === "function") {
      analytics.va("event", {
        name: "form_submit",
        data: { form: "newsletter", page },
      });
    }
    if (analytics.rybbit && typeof analytics.rybbit.event === "function") {
      analytics.rybbit.event("form_submit", { form: "newsletter", page });
    }
  }

  function setup() {
    const form = document.getElementById(
      "email-capture-form",
    ) as HTMLFormElement | null;
    const message = document.getElementById(
      "email-capture-message",
    ) as HTMLParagraphElement | null;
    if (!form || !message) return;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const email = (form.elements.namedItem("email") as HTMLInputElement)
        .value;
      const button = form.querySelector("button") as HTMLButtonElement;

      button.disabled = true;
      button.textContent = "Subscribing…";

      try {
        const res = await fetch("/api/subscribe", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email }),
        });

        const data = await res.json();

        if (res.ok && data.success) {
          form.classList.add("hidden");
          message.textContent =
            form.dataset.successMessage ??
            "Check your inbox for the welcome email.";
          message.className = "text-sm mt-3 text-green-600 dark:text-green-400";
          trackSubscription();
        } else {
          message.textContent =
            data.error ?? "Something went wrong. Please try again.";
          message.className = "text-sm mt-3 text-red-500 dark:text-red-400";
          button.disabled = false;
          button.textContent = "Subscribe";
        }
      } catch {
        message.textContent = "Network error. Please try again.";
        message.className = "text-sm mt-3 text-red-500 dark:text-red-400";
        button.disabled = false;
        button.textContent = "Subscribe";
      }
    });
  }

  document.addEventListener("astro:page-load", setup);
</script>
