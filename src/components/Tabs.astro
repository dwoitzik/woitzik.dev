---
export interface Tab {
  label: string;
  content: string;
}

interface Props {
  tabs: Tab[];
  group?: string;
}

const { tabs, group = "default" } = Astro.props;
const groupId = `tabs-${group}-${Math.random().toString(36).slice(2, 8)}`;
---

<div
  class="not-prose my-6 rounded-lg border border-neutral-200 dark:border-neutral-800 overflow-hidden"
>
  <div
    class="flex border-b border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900/50"
    role="tablist"
  >
    {
      tabs.map((tab, i) => (
        <button
          role="tab"
          id={`${groupId}-tab-${i}`}
          aria-controls={`${groupId}-panel-${i}`}
          data-tab={`${groupId}-${i}`}
          data-group={groupId}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? "0" : "-1"}
          class:list={[
            "px-4 py-2 text-sm font-medium transition-colors border-b-2 -mb-px",
            i === 0
              ? "border-sky-500 text-sky-600 dark:text-sky-400"
              : "border-transparent text-neutral-500 dark:text-neutral-400 hover:text-black dark:hover:text-white",
          ]}
        >
          {tab.label}
        </button>
      ))
    }
  </div>
  <div class="p-4">
    {
      tabs.map((tab, i) => (
        <div
          role="tabpanel"
          id={`${groupId}-panel-${i}`}
          aria-labelledby={`${groupId}-tab-${i}`}
          data-panel={`${groupId}-${i}`}
          class:list={["text-sm", i !== 0 && "hidden"]}
          tabindex="0"
          set:html={tab.content}
        />
      ))
    }
  </div>
</div>

<script is:inline>
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll("[role='tablist']").forEach((tablist) => {
      const tabs = tablist.querySelectorAll("[role='tab']");

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => activateTab(tab));
        tab.addEventListener("keydown", (e) => {
          const tabArray = Array.from(tabs);
          const index = tabArray.indexOf(tab);
          let newIndex = index;

          if (e.key === "ArrowRight") newIndex = (index + 1) % tabArray.length;
          else if (e.key === "ArrowLeft")
            newIndex = (index - 1 + tabArray.length) % tabArray.length;
          else if (e.key === "Home") newIndex = 0;
          else if (e.key === "End") newIndex = tabArray.length - 1;
          else return;

          e.preventDefault();
          activateTab(tabArray[newIndex]);
          tabArray[newIndex].focus();
        });
      });
    });

    function activateTab(tab) {
      const group = tab.getAttribute("data-group");
      const allTabs = document.querySelectorAll(`[data-group="${group}"]`);

      allTabs.forEach((t) => {
        t.setAttribute("aria-selected", "false");
        t.setAttribute("tabindex", "-1");
        t.classList.remove(
          "border-sky-500",
          "text-sky-600",
          "dark:text-sky-400",
        );
        t.classList.add(
          "border-transparent",
          "text-neutral-500",
          "dark:text-neutral-400",
        );
      });

      tab.setAttribute("aria-selected", "true");
      tab.setAttribute("tabindex", "0");
      tab.classList.add("border-sky-500", "text-sky-600", "dark:text-sky-400");
      tab.classList.remove(
        "border-transparent",
        "text-neutral-500",
        "dark:text-neutral-400",
      );

      allTabs.forEach((t) => {
        const panel = document.querySelector(
          `[data-panel="${t.getAttribute("data-tab")}"]`,
        );
        if (panel)
          panel.classList.toggle(
            "hidden",
            t.getAttribute("aria-selected") !== "true",
          );
      });
    }
  });
</script>
