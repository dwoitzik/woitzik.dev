---
import { postText, type Lang } from "@lib/utils";

interface Props {
  slug: string;
  lang?: Lang;
}

const { slug, lang = "en" } = Astro.props;
const text = postText(lang);
---

<div class="not-prose flex flex-wrap items-center gap-3">
  <span class="text-sm text-neutral-500 dark:text-neutral-400 shrink-0">
    {text.helpful}
  </span>
  <div class="flex gap-2">
    <button
      data-feedback="up"
      data-slug={slug}
      class="feedback-btn inline-flex min-h-11 min-w-[3.5rem] items-center justify-center px-4 text-sm rounded-md border border-neutral-200 dark:border-neutral-700 text-neutral-500 dark:text-neutral-400 hover:border-emerald-500 hover:text-emerald-500 transition-colors"
    >
      {text.yes}
    </button>
    <button
      data-feedback="down"
      data-slug={slug}
      class="feedback-btn inline-flex min-h-11 min-w-[3.5rem] items-center justify-center px-4 text-sm rounded-md border border-neutral-200 dark:border-neutral-700 text-neutral-500 dark:text-neutral-400 hover:border-red-500 hover:text-red-500 transition-colors"
    >
      {text.no}
    </button>
  </div>
  <span
    data-feedback-result
    class="text-xs text-neutral-400 dark:text-neutral-500 hidden"
  >
    {text.thanks}
  </span>
</div>

<script is:inline>
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll(".feedback-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const slug = btn.getAttribute("data-slug");
        const type = btn.getAttribute("data-feedback");
        if (!slug || !type) return;

        try {
          const key = `feedback-${slug}`;
          localStorage.setItem(key, type);
        } catch {
          /* localStorage may be unavailable */
        }

        // The vote itself has to reach the analytics backend, otherwise the
        // widget only ever counts something on the reader's own machine and
        // there is no way to tell which article actually answered the question.
        // Only the verdict and the slug go out - no free text, no identifying
        // data, nothing about who clicked.
        try {
          window.rybbit?.event?.("article_feedback", {
            slug,
            verdict: type,
            page: location.pathname,
          });
        } catch {
          /* analytics blocked */
        }

        document.querySelectorAll(`[data-slug="${slug}"]`).forEach((b) => {
          b.disabled = true;
          b.classList.add("opacity-40");
        });

        const result = btn.parentElement?.parentElement?.querySelector(
          "[data-feedback-result]",
        );
        if (result) {
          result.classList.remove("hidden");
        }
      });

      // Restore state
      try {
        const slug = btn.getAttribute("data-slug");
        const saved = localStorage.getItem(`feedback-${slug}`);
        if (saved === btn.getAttribute("data-feedback")) {
          btn.disabled = true;
          btn.classList.add("opacity-40");
          const result = btn.parentElement?.parentElement?.querySelector(
            "[data-feedback-result]",
          );
          if (result) result.classList.remove("hidden");
        }
      } catch {
        /* localStorage may be unavailable */
      }
    });
  });
</script>
