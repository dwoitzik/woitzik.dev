---
interface Props {
  title: string;
  eyebrow?: string;
  description?: string;
  meta?: string;
}
const { title, eyebrow, description, meta } = Astro.props;
---

<header class="animate mb-12 max-w-3xl">
  {
    eyebrow && (
      <p class="mb-3 font-mono text-xs uppercase tracking-wider text-teal-700 dark:text-teal-400">
        {eyebrow}
      </p>
    )
  }
  <h1 class="page-title">{title}</h1>
  {
    description && (
      <p class="mt-4 text-lg leading-relaxed text-zinc-600 dark:text-zinc-400">
        {description}
      </p>
    )
  }
  {meta && <p class="mt-3 font-mono text-xs text-zinc-500">{meta}</p>}
  <slot />
</header>
