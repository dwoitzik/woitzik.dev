---
// Intentionally renders nothing.
//
// Most posts still import this and place it at the end of the MDX body, and a
// few place it mid-article. The post layout (src/pages/blog/[...slug].astro)
// already renders the full newsletter form after every article, so the inline
// "Want the next article by email?" line showed up as a second newsletter
// block a few hundred pixels above the real one. Keeping the component (and
// its props) means the 65 MDX imports keep compiling; the layout form is the
// single newsletter block per post.
export interface Props {
  variant?: "inline" | "compact";
}
