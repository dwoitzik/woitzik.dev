---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";

export type ToolFaq = { q: string; a: string };
export type ToolLink = { href: string; label: string };

type Props = {
  title: string;
  description: string;
  /** Path of the tool, e.g. "/tools/subnet-calculator/". Used for the JSON-LD url. */
  path: string;
  /** One-line summary of what the tool computes, shown under the h1. */
  intro: string;
  faqs: ToolFaq[];
  /** Sibling tools and articles worth reading next. */
  related?: ToolLink[];
};

const { title, description, path, intro, faqs, related = [] } = Astro.props;

// WebApplication is the SoftwareApplication subtype for tools that run in the
// browser. No aggregateRating or review: there are none to report, and
// inventing them is a structured data policy violation.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: title,
  url: `https://woitzik.dev${path}`,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Any",
  browserRequirements: "Requires JavaScript",
  isPartOf: { "@id": "https://woitzik.dev/#website" },
  description,
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
  isAccessibleForFree: true,
  author: { "@id": "https://woitzik.dev/#person" },
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://woitzik.dev/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Tools",
      item: "https://woitzik.dev/tools/",
    },
    { "@type": "ListItem", position: 3, name: title },
  ],
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.q,
    acceptedAnswer: { "@type": "Answer", text: faq.a },
  })),
};
---

<PageLayout title={title} description={description}>
  <Container>
    <div class="space-y-8">
      <div class="animate max-w-3xl">
        <a
          href="/tools/"
          class="font-mono text-xs uppercase tracking-wider text-teal-700 hover:text-teal-800 dark:text-teal-400 dark:hover:text-teal-300"
          >&larr; Tools</a
        >
        <h1 class="page-title mt-3">
          {title}
        </h1>
        <p
          class="mt-4 text-lg leading-relaxed text-zinc-600 dark:text-zinc-400"
        >
          {intro}
        </p>
      </div>

      <!--
        Every tool passes its input card first and its result card second. On
        lg those two sit side by side so the calculator uses the full frame;
        everything after them (reference tables, notes) spans both columns, and
        running text keeps a readable measure.
      -->
      <div
        class="space-y-8 lg:grid lg:grid-cols-2 lg:items-start lg:gap-8 lg:space-y-0 lg:[&>*:nth-child(n+3)]:col-span-2 lg:[&>p]:max-w-3xl"
      >
        <slot />
      </div>

      <h2 class="max-w-3xl font-semibold text-lg text-black dark:text-white">
        Frequently Asked Questions
      </h2>
      <div class="max-w-3xl space-y-4">
        {
          faqs.map((faq) => (
            <div>
              <h3 class="font-semibold text-sm text-black dark:text-white mb-1">
                {faq.q}
              </h3>
              <p class="text-sm text-neutral-600 dark:text-neutral-300 m-0 leading-relaxed">
                {faq.a}
              </p>
            </div>
          ))
        }
      </div>

      {
        related.length > 0 && (
          <div class="max-w-3xl space-y-2">
            <h2 class="font-semibold text-lg text-black dark:text-white">
              Related
            </h2>
            <ul class="space-y-1 text-sm m-0 pl-0 list-none">
              {related.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sky-700 dark:text-sky-400 hover:underline"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </Container>
</PageLayout>

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(jsonLd)}
/>

<script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)} />

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(breadcrumbLd)}
/>
