{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/go/:key", "destination": "/api/go/:key" }],
  "redirects": [
    { "source": "/agb", "destination": "/legal/", "permanent": true },
    { "source": "/widerruf", "destination": "/legal/", "permanent": true },
    { "source": "/widerrufsbutton", "destination": "/legal/", "permanent": true }
  ]
}
